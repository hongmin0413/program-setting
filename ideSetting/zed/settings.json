// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // 字體與主題
  "cli_default_open_behavior": "new_window",
  "buffer_font_family": ".ZedMono",
  "buffer_font_size": 18.0,
  "ui_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "VSCode Dark Modern",
    "dark": "VSCode Dark Modern"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "session": {
    "trust_all_worktrees": true
  },

  // 編輯器行為
  "autosave": "on_focus_change",
  "linked_edits": true,
  "tab_size": 4,
  "hard_tabs": false,
  "ensure_final_newline_on_save": false,
  "remove_trailing_whitespace_on_save": false,
  "soft_wrap": "none",
  "scroll_beyond_last_line": "one_page",
  "minimap": {
    "show": "never"
  },

  // git：關閉每一行的 blame 提示
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },

  // 版面：左邊檔案與 debug，右邊 AI，下方終端機
  "diff_view_style": "split",
  "project_panel": {
    "dock": "left",
    "starts_open": false
  },
  //2026.10.21 inlay hints：在程式碼中直接顯示額外資訊(例如呼叫方法時每個參數的名稱、變數推斷出來的型別)，Zed預設是關閉的
  "inlay_hints": {
    //總開關：false時下面的子開關都沒作用
    "enabled": true,
    //顯示型別，例如 var list = new ArrayList<String>() 後面顯示變數的實際型別
    "show_type_hints": true,
    //顯示參數名稱，例如 getUser(1, true) 顯示成 getUser(id: 1, isActive: true)
    "show_parameter_hints": true,
    //顯示其他種類的提示(不是型別也不是參數的，由各語言的語言伺服器決定)
    "show_other_hints": true,
    //偵錯時在程式碼行尾顯示變數目前的值(只有偵錯中才有；官方預設就是true)
    "show_value_hints": true,
    //提示文字加上背景色，比較容易跟真正的程式碼區分
    "show_background": false,
    //編輯後等多少毫秒才更新提示(避免打字時一直閃)
    "edit_debounce_ms": 700,
    //捲動後等多少毫秒才更新提示
    "scroll_debounce_ms": 50
  },
  "git_panel": {
    "button": false
  },
  "outline_panel": {
    "dock": "right"
  },
  "agent": {
    "show_merge_conflict_indicator": false,
    "dock": "right"
  },
  "terminal": {
    "dock": "bottom",
    "font_size": 18.0,
    "copy_on_select": true
  },
  "debugger": {
    "dock": "left"
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
    "show_pinned_tabs_in_separate_row": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors"
  },
  "preview_tabs": {
    "enabled": true
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false
  },
  "collaboration_panel": {
    "button": false
  },
  "title_bar": {
    "show_branch_name": true,
    "show_onboarding_banner": false
  },

  // 自動安裝的擴充
  "auto_install_extensions": {
    "java": true,
    "html": true,
    "xml": true,
    "vue": true,
    "windows-batch": true,
    "material-icon-theme": true,
    "vscode-dark-modern": true,
    "dockerfile": true,
    "emmet": true,
    "powershell": true
  },

  // Java：autobuild、nullAnalysis、updateBuildConfiguration
  "languages": {
    "Java": {
      "tab_size": 4,
      "hard_tabs": false
    },
    "HTML": {
      "format_on_save": "off"
    }
  },
  "lsp": {
    "jdtls": {
      "settings": {
        "java_home": "D:\\java\\jdk-25.0.4.1+1"
      },
      "initialization_options": {
        "settings": {
          "java": {
            "autobuild": {
              "enabled": true
            },
            "configuration": {
              "updateBuildConfiguration": "automatic"
            },
            "compile": {
              "nullAnalysis": {
                "mode": "automatic"
              }
            }
          }
        }
      }
    }
  }
}
